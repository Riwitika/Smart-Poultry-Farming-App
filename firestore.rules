rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection rules: user must be authenticated and matching uid
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Predictions collection rules: read, delete and updates must belong to the record owner.
    match /predictions/{predictionId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == request.resource.data.uid && request.auth.uid == resource.data.uid;
    }
  }
}
